# Cloudflare Pages > Settings > Variables and Secrets (Production and Preview).
# Use the pooled connection string from the dedicated Mahto Neon project. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required for secure admin sessions and primary-admin sign-in.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional email notifications. Verify the sender domain with Resend first.
RESEND_API_KEY=re_your_key_here
ENQUIRY_FROM_EMAIL=Website Enquiries <verified-sender@example.com>
ENQUIRY_NOTIFICATION_TO=agency@example.com
