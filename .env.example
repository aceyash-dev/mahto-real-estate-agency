# Set this in Vercel Project Settings -> Environment Variables (Production and Preview as appropriate).
# Use the connection string from the dedicated Mahto Neon project. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: configure Resend email notifications after verifying the sender domain.
RESEND_API_KEY=re_your_key_here
ENQUIRY_FROM_EMAIL=Website Enquiries <verified-sender@example.com>
ENQUIRY_NOTIFICATION_TO=princewebdev05@gmail.com
